{
    "version": "0.2.1",
    "defaults": {},
    "configurations": [
        {
            "type": "cppdbg",
            "name": "Server", // this is arbitrary name
            "request": "launch",
            "project": "c://windows//system32//cmd.exe",
            "program": "Server", // relative path to binary to run
            "args": [],
            "environment": [],
            "stopAtEntry": true,
            "cwd": ".",
            "externalConsole": false,
            "pipeTransport": {
                "pipeCwd": "${workspaceRoot}",
                "pipeProgram": "wsl",
                "pipeArgs": [ "${debuggerCommand}" ]
            },
            "MIMode": "gdb"
        }
    ]
}
